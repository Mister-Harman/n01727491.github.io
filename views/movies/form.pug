extends ../layout

block content
  if isEdit
    h1 Edit Movie
  else
    h1 Add Movie

  if errors.length
    ul.error-list
      each err in errors
        li= err.msg

  form(method="post", action=isEdit ? `/movies/${movie._id}?_method=PUT` : "/movies")
    .form-group
      label(for="title") Title
      input#title(type="text", name="title", required, value=movie.title || '')
    .form-group
      label(for="description") Description
      textarea#description(name="description", rows="4", required)= movie.description || ''
    .form-group
      label(for="year") Year
      input#year(type="number", name="year", required, value=movie.year || '')
    .form-group
      label(for="rating") Rating (0–10, optional)
      input#rating(type="number", name="rating", min="0", max="10", step="0.1", value=movie.rating || '')
    .form-group
      label(for="genres") Genres (comma separated)
      input#genres(type="text", name="genres", placeholder="Action, Drama", value=movie.genres || '')
    button.btn(type="submit") Save

    a.btn.btn-secondary(href="/movies") Cancel
